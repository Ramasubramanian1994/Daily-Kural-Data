/* ==========================================================================
   DYNAMIC GITHUB FETCH FUNCTION (CANONICAL URL + CACHE BUSTING + AUTO FALLBACK)
   ========================================================================== */
async function loadChapterData(chNum) {
  try {
    let formattedNum = String(chNum).padStart(3, '0');
    let container = document.getElementById('kuralListContainer');
    container.innerHTML = `<div style="text-align:center; padding: 30px; font-weight:bold; color:#c26100;">அதிகாரம் ${chNum} குறள்கள் ஏற்றப்படுகின்றன...</div>`;

    // Cache-buster timestamp bypasses GitHub's 5-minute 404 cache
    let cacheBuster = `?t=${Date.now()}`;
    
    // Primary URL (Direct canonical URL without /refs/heads/ to prevent CORS redirect blocks)
    let url1 = `https://raw.githubusercontent.com/Ramasubramanian1994/Daily-Kural-Data/main/${formattedNum}-Chapter.json${cacheBuster}`;
    // Fallback 1: Revised naming
    let url2 = `https://raw.githubusercontent.com/Ramasubramanian1994/Daily-Kural-Data/main/${formattedNum}-Chapter-Revised.json${cacheBuster}`;
    // Fallback 2: refs/heads/ path
    let url3 = `https://raw.githubusercontent.com/Ramasubramanian1994/Daily-Kural-Data/refs/heads/main/${formattedNum}-Chapter.json${cacheBuster}`;

    let response = await fetch(url1, { cache: 'no-cache' });
    if (!response.ok) {
      response = await fetch(url2, { cache: 'no-cache' });
    }
    if (!response.ok) {
      response = await fetch(url3, { cache: 'no-cache' });
    }

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}: File not accessible on GitHub`);
    }

    let data = await response.json();
    kuralsData = data.kurals || [];

    // Classical Section (Iyal & Paal) Dynamic Mapping
    let defaultIyal = "பாயிரவியல்";
    let defaultPaal = "அறத்துப்பால்";

    if (chNum >= 1 && chNum <= 4) {
      defaultIyal = "பாயிரவியல்";
      defaultPaal = "அறத்துப்பால்";
    } else if (chNum >= 5 && chNum <= 24) {
      defaultIyal = "இல்லறவியல்";
      defaultPaal = "அறத்துப்பால்";
    } else if (chNum >= 25 && chNum <= 37) {
      defaultIyal = "துறவறவியல்";
      defaultPaal = "அறத்துப்பால்";
    } else if (chNum === 38) {
      defaultIyal = "ஊழியல்";
      defaultPaal = "அறத்துப்பால்";
    } else if (chNum >= 39 && chNum <= 108) {
      defaultPaal = "பொருட்பால்";
      defaultIyal = chNum <= 63 ? "அரசியல்" : (chNum <= 95 ? "அமைச்சியல்" : "ஒழிபியல்");
    } else {
      defaultPaal = "காமத்துப்பால்";
      defaultIyal = chNum <= 115 ? "களவியல்" : "கற்பியல்";
    }

    let foundDir = chaptersDirectory.find(c => c.no === chNum);
    currentChapterMeta = {
      nameTa: decodeHtml(data.nameTa || (foundDir ? foundDir.ta : `அதிகாரம் ${chNum}`)),
      paalTa: decodeHtml(data.paal || defaultPaal),
      iyalTa: decodeHtml(data.iyal || defaultIyal)
    };

    currentIndex = 0;
    renderKuralList();
    updateModalMetadata();
    updateBoundaryNavigation();

    // Update Dropdown UI to match active chapter
    let dropdown = document.getElementById('chapterDropdown');
    if (dropdown && dropdown.value != chNum) {
      dropdown.value = chNum;
    }

    // Keep URL parameter synchronized (?ch=2)
    if (window.history && window.history.replaceState) {
      let newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname + `?ch=${chNum}`;
      window.history.replaceState({ path: newUrl }, '', newUrl);
    }

  } catch (error) {
    console.error("Error loading chapter data:", error);
    document.getElementById('kuralListContainer').innerHTML = `
      <div style="text-align:center; padding: 30px; color:#e53935; font-weight:bold;">
        ⚠️ அதிகாரம் ${chNum} தரவை ஏற்ற முடியவில்லை.<br>
        <span style="font-size:13px; color:#6a5338; font-weight:normal;">
          காரணம்: ${error.message}<br>
          GitHub-இல் <b>${String(chNum).padStart(3, '0')}-Chapter.json</b> கோப்பு உள்ளதா என சரிபார்க்கவும்.
        </span>
      </div>`;
    updateBoundaryNavigation();
  }
}

function onChapterSelectChange(val) {
  currentChapter = parseInt(val, 10);
  loadChapterData(currentChapter);
}

function navigateChapter(direction) {
  let newCh = currentChapter + direction;
  if (newCh >= 1 && newCh <= 133) {
    currentChapter = newCh;
    loadChapterData(newCh);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

// Initial Page Load: reads ?ch=X from URL or defaults to Chapter 1
window.addEventListener('DOMContentLoaded', function() {
  populateDropdown();
  const urlParams = new URLSearchParams(window.location.search);
  const chParam = parseInt(urlParams.get('ch'), 10);
  if (chParam && chParam >= 1 && chParam <= 133) {
    currentChapter = chParam;
  } else {
    currentChapter = 1;
  }
  loadChapterData(currentChapter);
  hookCentralizedTranslationButton();
});
